# Exercise 2 - minimal SOP/POS, four variables, on the Terasic DE1 (Cyclone II EP2C20F484C7), Quartus II 13.0sp1
set_global_assignment -name FAMILY "Cyclone II"
set_global_assignment -name DEVICE EP2C20F484C7
set_global_assignment -name TOP_LEVEL_ENTITY ex2_top
set_global_assignment -name VERILOG_FILE ex2_top.v
set_global_assignment -name VERILOG_FILE student_logic.v
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED"
set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "3.3-V LVTTL"

set_location_assignment PIN_L22 -to SW[0]
set_location_assignment PIN_L21 -to SW[1]
